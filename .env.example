# Quasnex Environment Configuration
# Copy this file to .env and fill in your values. All providers speak the
# OpenAI-compatible chat-completions API, so any combination can be configured.

# Which provider the agent uses if no capability role is active. Normal chat
# first asks the planner model to analyze and automatically route each query.
DEFAULT_PROVIDER=lightning

# Sampling temperature / retry-on-transient-failure count, applied to every
# provider unless overridden per-provider below (LIGHTNING_TEMPERATURE,
# NVIDIA_TEMPERATURE, etc.). Lower temperature = fewer syntax/tool-arg
# mistakes on coding tasks; raise retries if your endpoint cold-starts often.
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_RETRIES=2

# Self-hosted OpenAI-compatible gateway (e.g. a Lightning AI GPU instance
# running vLLM/Ollama behind an OpenAI-compatible proxy).
LIGHTNING_PROVIDER=true
LIGHTNING_BASE_URL=https://your-instance.cloudspaces.litng.ai/v1
LIGHTNING_API_KEY=your_lightning_gateway_key
# Comma-separated list of models the gateway serves. First is the default.
LIGHTNING_MODELS=qwen2.5-coder:14b
# LIGHTNING_TEMPERATURE=0.2
# LIGHTNING_MAX_RETRIES=2

# NVIDIA NIM API (hosted open-source models).
NVIDIA_PROVIDER=true
NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODELS=openai/gpt-oss-120b,mistralai/mistral-nemotron,nvidia/nemotron-3-ultra-550b-a55b,qwen/qwen3-next-80b-a3b-instruct,qwen/qwen2.5-coder-32b-instruct,openai/gpt-oss-20b
# NVIDIA_TEMPERATURE=0.2
# NVIDIA_MAX_RETRIES=2

# OpenRouter (hosted gateway for models from multiple providers).
# OPENROUTER_PROVIDER=true
# Create a key at https://openrouter.ai/settings/keys and use OpenRouter model slugs.
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated model inventory available to the internal automatic router.
# /model exposes PLANNER_MODEL plus configured gpt-oss-120b and Nemotron routes.
# OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Optional app attribution headers sent with OpenRouter requests:
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_NAME=Quasnex
# OPENROUTER_TEMPERATURE=0.2
# OPENROUTER_MAX_RETRIES=2

# Optional preferred route for each capability. These routes become the first
# candidates the planner considers. Defaults prefer NVIDIA for planning,
# repository/documentation reasoning, testing, and deployment, plus a
# configured code-tuned model for coding/debugging.
# PLANNER_MODEL=nvidia:openai/gpt-oss-120b
# REPOSITORY_SEARCH_MODEL=nvidia:qwen/qwen3-next-80b-a3b-instruct
# DOCUMENTATION_MODEL=nvidia:qwen/qwen3-next-80b-a3b-instruct
# CODING_MODEL=lightning:qwen2.5-coder:14b
# DEBUGGING_MODEL=lightning:qwen2.5-coder:14b
# TESTING_MODEL=nvidia:openai/gpt-oss-120b
# DEPLOYMENT_MODEL=nvidia:openai/gpt-oss-120b
# Any role can use an OpenRouter model listed in OPENROUTER_MODELS, for example:
# PLANNER_MODEL=openrouter:openrouter/auto
