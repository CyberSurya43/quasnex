# Cosnex Environment Configuration
# Copy this file to .env and fill in your values. All providers speak the
# OpenAI-compatible chat-completions API, so any combination can be configured.

# Which provider the agent uses by default. Switch at runtime with /model
# inside the chat REPL.
DEFAULT_PROVIDER=lightning

# Sampling temperature / retry-on-transient-failure count, applied to every
# provider unless overridden per-provider below (LIGHTNING_TEMPERATURE,
# NVIDIA_TEMPERATURE, etc.). Lower temperature = fewer syntax/tool-arg
# mistakes on coding tasks; raise retries if your endpoint cold-starts often.
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_RETRIES=2

# Self-hosted OpenAI-compatible gateway (e.g. a Lightning AI GPU instance
# running vLLM/Ollama behind an OpenAI-compatible proxy).
LIGHTNING_BASE_URL=https://your-instance.cloudspaces.litng.ai/v1
LIGHTNING_API_KEY=your_lightning_gateway_key
# Comma-separated list of models the gateway serves. First is the default.
LIGHTNING_MODELS=qwen2.5-coder:14b
# LIGHTNING_TEMPERATURE=0.2
# LIGHTNING_MAX_RETRIES=2

# NVIDIA NIM API (hosted open-source models).
NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODELS=qwen/qwen3-next-80b-a3b-instruct,openai/gpt-oss-20b,mistralai/codestral-22b-instruct-v0.1,deepseek-ai/deepseek-coder-6.7b-instruct
# NVIDIA_TEMPERATURE=0.2
# NVIDIA_MAX_RETRIES=2

# OpenRouter (hosted gateway for models from multiple providers).
# Create a key at https://openrouter.ai/settings/keys and use OpenRouter model slugs.
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated models shown by /model in this same order.
# OPENROUTER_MODELS=openrouter/auto,provider/model-slug
# Optional app attribution headers sent with OpenRouter requests:
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_NAME=Cosnex
# OPENROUTER_TEMPERATURE=0.2
# OPENROUTER_MAX_RETRIES=2
